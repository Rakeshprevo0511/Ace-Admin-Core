root = true

# ===============================
# Global
# ===============================
[*]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ===============================
# JavaScript
# ===============================
[*.js]
indent_size = 2
max_blank_lines = 1

# ===============================
# HTML
# ===============================
[*.html]
indent_size = 2
max_blank_lines = 1

# ===============================
# C#
# ===============================
[*.cs]
indent_size = 4

csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

# Default
[*]
indent_style = space
indent_size = 2

# C# (.NET)
[*.cs]
indent_size = 4

# JavaScript
[*.js]
indent_size = 2

# HTML
[*.html]
indent_size = 2

# CSS
[*.css]
indent_size = 2

# JSON
[*.json]
indent_size = 2
