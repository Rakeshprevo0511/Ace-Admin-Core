                <!-- Card body -->
                <div class="card-body border-x-1 brc-primary-l1 p-0">
                    <div class="ace-scroll ace-scroll-wrap" data-ace-scroll="{&quot;height&quot;: 380, &quot;smooth&quot;:true}" style="max-height: 398px;">
                        <div class="ace-scroll-inner" id="conversations" style="color: rgb(65, 70, 77);">
                            <!-- Messages will be rendered here dynamically -->
                            <div class="msg" id="msg-1">
                                <span class="tick"></span>
                            </div>
                        </div>
                       
                    </div>
                </div>

                <!-- Card footer: Input -->
                <div class="card-footer px-25 pt-1px bgc-white border-1 border-t-0 brc-primary-l1 radius-b-2">
                    <div class="mb-0 p-3 dcard brc-grey-l1">
                        <div class="input-group input-group-fade">
                            <input id="id-reply" type="text" class="form-control pl-2 border-0 radius-0 shadow-none" placeholder="Write your message ...">

                            <div class="input-group-append">
                                <button id="sendBtn" class="btn btn-info radius-3px" type="button">
                                    Send
                                    <i class="fa fa-angle-right ml-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div><!-- /.card-footer -->

            </div><!-- /.card -->
        </div>
    </div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.9/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chathub")
        .build();

    const sendBtn = document.getElementById("sendBtn");
    const msgInput = document.getElementById("id-reply");
    const chatContainer = document.getElementById("conversations");

    const currentUserId = localStorage.getItem("currentUserId");
    let receiverId = null; // initially no receiver selected
   
    sendBtn.disabled = true;

    // ===== STYLE FOR BLUE TICKS =====
    const style = document.createElement("style");
    style.textContent = `
        .tick::after {
            content: "✔✔";
            color: gray;
            font-size: 12px;
            margin-left: 4px;
            transition: color 0.3s ease;
        }
        .tick.seen::after {
            color: #007bff; /* blue */
        }
        .date-separator {
            text-align: center;
            margin: 10px 0;
            font-weight: 600;
            color: #666;
            position: relative;
        }
        .date-separator::before,
        .date-separator::after {
            content: "";
            position: absolute;
            top: 50%;
            width: 40%;
            height: 1px;
            background: #ccc;
        }
        .date-separator::before { left: 0; }
        .date-separator::after { right: 0; }
    `;
    document.head.appendChild(style);

    // ====== SIGNALR START ======
    connection.start()
        .then(() => {
            console.log("✅ SignalR connected");
            sendBtn.disabled = false;
            loadUserList();
            chatContainer.innerHTML = '';

            connection.invoke("LoadHistory", currentUserId, receiverId)
                .then(messages => {
                    renderChatByDate(messages);
                })
                .catch(err => console.error(err));

            sendBtn.addEventListener("click", () => {
                const message = msgInput.value.trim();
                if (!message) return;

                connection.invoke("SendMessage",
                    currentUserId,
                    receiverId,
                    message,
                    "text",  // messageType
                    null     // attachmentUrl
                ).catch(err => console.error(err.toString()));

                msgInput.value = "";
            });
        })
        .catch(err => console.error("SignalR connection failed:", err));

    // ====== RECEIVE MESSAGE ======
    connection.on("ReceiveMessage", (msg) => {
        appendMessage(msg);
    });

    // ====== MESSAGE SEEN UPDATE ======
    connection.on("MessageSeen", (messageId) => {
        const tick = document.getElementById(`tick-${messageId}`);
        if (tick) tick.classList.add("seen"); // turn blue
    });

    // ====== RENDER CHAT GROUPED BY DATE ======
    function renderChatByDate(messages) {
        chatContainer.innerHTML = "";

        let lastDate = null;

        messages.forEach(msg => {
            const sentDate = new Date(msg.sentAt || msg.SentAt);
            const dateKey = sentDate.toDateString();

            // Show a new date separator when date changes
            if (dateKey !== lastDate) {
                const separator = document.createElement("div");
                separator.classList.add("date-separator");
                separator.textContent = formatDateLabel(sentDate);
                chatContainer.appendChild(separator);
                lastDate = dateKey;
            }

            appendMessage(msg);
        });
    }

    // ====== RENDER SINGLE MESSAGE ======
    function appendMessage(msg) {
        const userId = msg.userId || msg.UserId;
        const message = msg.message || msg.Message;
        const sentAt = msg.sentAt || msg.SentAt;
        const attachmentUrl = msg.attachmentUrl || msg.AttachmentUrl;
        const isSeen = msg.isSeen || msg.IsSeen || false;
        const id = msg.id || msg.Id;

        const sentTime = new Date(sentAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const tickClass = isSeen ? "tick seen" : "tick";

        const msgDiv = document.createElement("div");
        msgDiv.classList.add("px-3", "conversation", userId === currentUserId ? "text-right" : "text-left");

        msgDiv.innerHTML = `
            <div class="d-flex ${userId === currentUserId ? "flex-row-reverse" : ""} align-items-start col px-0 mb-2">
                <div class="mr-3 mt-2px">
                    <div class="pos-rel">
                        <img src="/assets/image/avatar/avatar1.jpg" class="radius-round w-4 h-4" />
                    </div>
                </div>
                <div class="col px-0">
                    <div class="py-2 px-3 radius-1 ${userId === currentUserId ? "bgc-primary-l3 text-dark-m1" : "bgc-grey-l3 text-dark-m1"}">
                        <div class="text-90" style="max-width: 480px;">
                            ${message}
                            ${attachmentUrl ? `<br><img src="${attachmentUrl}" width="100" />` : ""}
                        </div>
                        <div class="text-80 text-grey-m2 mt-1">
                            ${sentTime} ${userId === currentUserId ? `<span class="${tickClass}" id="tick-${id}"></span>` : ""}
                        </div>
                    </div>
                </div>
            </div>
        `;

        chatContainer.appendChild(msgDiv);
        chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    // ====== FORMAT DATE LABEL ======
    function formatDateLabel(date) {
        const today = new Date();
        const yesterday = new Date();
        yesterday.setDate(today.getDate() - 1);

        if (date.toDateString() === today.toDateString()) {
            return "Today";
        } else if (date.toDateString() === yesterday.toDateString()) {
            return "Yesterday";
        } else {
            return date.toLocaleDateString([], { day: 'numeric', month: 'short', year: 'numeric' });
        }
    }
        function loadUserList() {
        const token = localStorage.getItem("employeeToken");
        const userDropdown = document.getElementById("userListDropdown");

        fetch("/api/users", {
            method: "GET",
            headers: {
                "Authorization": "Bearer " + token,
                "Content-Type": "application/json"
            }
        })
        .then(res => {
            if (!res.ok) throw new Error("Failed to fetch users: " + res.status);
            return res.json();
        })
        .then(users => {
            userDropdown.innerHTML = `<option value="">Select User</option>`;
            users.forEach(u => {
                if (u.id != currentUserId) {
                    const opt = document.createElement("option");
                    opt.value = u.id;
                    opt.textContent = u.name || u.fullName || `User ${u.id}`;
                    userDropdown.appendChild(opt);
                }
            });
        })
        .catch(err => console.error("Error loading users:", err));
    }

    // ====== Update receiverId when user selects a new user =====
       document.getElementById("userListDropdown").addEventListener("change", function() {
        receiverId = this.value;
        chatContainer.innerHTML = ""; // clear previous chat

        if (receiverId) {
            // Load chat history for selected user
            connection.invoke("LoadHistory", currentUserId, receiverId)
                .then(messages => renderChatByDate(messages))
                .catch(err => console.error(err));
        }
    });
</script>







