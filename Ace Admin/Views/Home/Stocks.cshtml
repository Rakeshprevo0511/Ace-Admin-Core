<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bank Nifty Live Tracker</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

    <style>


        /* Glassmorphism Card */
        .glass-card {
            backdrop-filter: blur(15px);
            background: var(--glass-bg-light);
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .glass-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 48px rgba(0, 0, 0, 0.15);
            }

        /* Gradient Header */
        .gradient-header {
            background: var(--primary-gradient);
            padding: 20px;
            border-radius: 16px 16px 0 0;
        }

        /* Price Change Indicators */
        .price-up {
            color: var(--success-color) !important;
            font-weight: 600;
        }

        .price-down {
            color: var(--danger-color) !important;
            font-weight: 600;
        }

        /* Chart Container */
        .chart-container {
            position: relative;
            height: 400px;
            background: white;
            border-radius: 12px;
            padding: 15px;
        }

        /* Stats Card */
        .stats-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

            .stats-card:hover {
                border-color: #005bea;
                transform: scale(1.05);
            }

        /* Table Styling */
        .table-responsive {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        }

        .table thead {
            background: var(--primary-gradient);
            color: white;
        }

        .table tbody tr {
            transition: background-color 0.2s ease;
        }

            .table tbody tr:hover {
                background-color: rgba(0, 91, 234, 0.05);
            }

        /* Loading Animation */
        .pulse-animation {
            animation: pulse 1.5s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        /* Section Title */
        .section-title {
            font-weight: 600;
            color: #333;
            margin: 20px 0 15px 0;
            font-size: 1.1rem;
        }

        /* Dark Mode Support */
        @@media (prefers-color-scheme: dark) {
            .glass-card {
                background: var(--glass-bg-dark);
                color: #eee;
            }

            .section-title {
                color: #ddd;
            }

            .stats-card {
                background: rgba(40, 40, 40, 0.9);
                color: #eee;
            }
        }

        /* Responsive Adjustments */
        @@media (max-width: 768px) {
            .chart-container {
                height: 300px;
            }

            h2 {
                font-size: 1.5rem;
            }
        }

        /* Stock Detail Modal */
        .stock-detail-card {
            max-width: 500px;
            margin: 20px auto;
        }

        /* Badge Styling */
        .live-badge {
            animation: blink 2s ease-in-out infinite;
        }

        @@keyframes blink {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.7;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid mt-4 px-3 px-md-4">
        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="text-dark mb-0">
                    <i class="fas fa-chart-line"></i>
                    Bank Nifty Live Tracker
                    <span class="badge bg-danger live-badge ms-2">LIVE</span>
                </h2>
            </div>
        </div>

        <!-- Price Summary Card -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-lg border-0 glass-card">
                    <div class="card-body py-3">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h4 class="mb-1 text-dark" id="chartTitle">
                                    <span class="pulse-animation">Loading...</span>
                                </h4>
                                <span id="chartExchange" class="badge bg-info fs-6">INDEX</span>
                            </div>
                            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                                <div class="fs-3 fw-bold text-dark" id="currentPrice">₹--.--</div>
                                <div id="priceChangeIndicator" class="mt-2">
                                    <span class="text-dark-50">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-2">
                        <div class="chart-container">
                            <canvas id="bankNiftyChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="stats-card">
                    <div class="text-muted small mb-2">
                        <i class="fas fa-arrow-up"></i> Day High
                    </div>
                    <div class="h4 fw-bold text-success mb-0" id="dayHigh">₹--.--</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stats-card">
                    <div class="text-muted small mb-2">
                        <i class="fas fa-arrow-down"></i> Day Low
                    </div>
                    <div class="h4 fw-bold text-danger mb-0" id="dayLow">₹--.--</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stats-card">
                    <div class="text-muted small mb-2">
                        <i class="fas fa-chart-bar"></i> Volume
                    </div>
                    <div class="h4 fw-bold text-primary mb-0" id="volume">--M</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stats-card">
                    <div class="text-muted small mb-2">
                        <i class="fas fa-chart-line"></i> MA(5)
                    </div>
                    <div class="h4 fw-bold text-info mb-0" id="ma50">₹--.--</div>
                </div>
            </div>
        </div>

        <!-- Stock Table -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-building me-2"></i>
                            Bank Nifty Constituent Stocks
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0" id="stockTable">
                                <thead>
                                    <tr>
                                        <th>Symbol</th>
                                        <th>Last Price</th>
                                        <th>Open</th>
                                        <th>High</th>
                                        <th>Low</th>
                                        <th>Prev Close</th>
                                        <th>Volume</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="8" class="text-center py-4">
                                            <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>
                                            <p class="mt-2 text-muted">Loading stock data...</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stock Detail Modal -->
        <div id="stockDetailSection" class="d-none">
            <div class="row">
                <div class="col-12">
                    <div class="card glass-card shadow-lg stock-detail-card">
                        <div class="card-header gradient-header">
                            <h3 id="detailCompany" class="text-white mb-1"></h3>
                            <small id="detailSymbol" class="text-light"></small>
                        </div>
                        <div class="card-body bg-white">
                            <p class="text-muted mb-3">
                                <strong>Industry:</strong> <span id="detailIndustry">N/A</span>
                            </p>

                            <h5 class="section-title">
                                <i class="fas fa-rupee-sign me-2"></i>Price Details
                            </h5>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <strong>Last Price:</strong>
                                    <div class="fs-5 text-primary" id="detailLastPrice">₹--</div>
                                </div>
                                <div class="col-6">
                                    <strong>Change:</strong>
                                    <div id="detailChange" class="fs-5">--</div>
                                    <div id="detailPChange" class="small">--</div>
                                </div>
                            </div>

                            <h5 class="section-title">
                                <i class="fas fa-chart-area me-2"></i>Day Range
                            </h5>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <strong>High:</strong>
                                    <div class="text-success" id="detailDayHigh">₹--</div>
                                </div>
                                <div class="col-6">
                                    <strong>Low:</strong>
                                    <div class="text-danger" id="detailDayLow">₹--</div>
                                </div>
                            </div>

                            <h5 class="section-title">
                                <i class="fas fa-chart-line me-2"></i>Price Trend
                            </h5>
                            <canvas id="stockDetailChart" height="120"></canvas>

                            <div class="text-center mt-3">
                                <small class="text-muted" id="detailLastUpdate">
                                    Last update: Never
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

    <script>
        // Configuration Object
        const CONFIG = {
            UPDATE_INTERVAL: 60000, // 60 seconds
            MAX_DATA_POINTS: 60,
            MOVING_AVERAGE_PERIOD: 5,
            CHART_ANIMATION_DURATION: 300,
            API_TIMEOUT: 15000
        };

        // Application State
        const AppState = {
            mainChart: null,
            detailChart: null,
            dataSeries: {
                timestamps: [],
                prices: []
            },
            isUpdating: false,
            updateTimer: null
        };

        // Utility Functions
        const Utils = {
            formatCurrency: (value) => {
                return '₹' + Number(value).toLocaleString('en-IN', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            },

            formatVolume: (value) => {
                return (value / 1000000).toLocaleString('en-IN', {
                    maximumFractionDigits: 2
                }) + 'M';
            },

            formatTime: () => {
                return new Date().toLocaleTimeString('en-IN', {
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });
            },

            calculateMA: (data, period) => {
                if (data.length < period) return 0;
                const recent = data.slice(-period);
                return recent.reduce((sum, v) => sum + v, 0) / recent.length;
            },

            showError: (message) => {
                console.error('❌ Error:', message);
                $('#priceChangeIndicator').html(
                    `<span class="text-danger">
                        <i class="fas fa-exclamation-triangle"></i> ${message}
                    </span>`
                );
            },

            showLoading: (element) => {
                $(element).html(
                    '<i class="fas fa-spinner fa-spin text-primary"></i> Loading...'
                );
            }
        };

        // Chart Manager
        const ChartManager = {
            initMainChart: () => {
                const canvas = document.getElementById('bankNiftyChart');
                if (!canvas) {
                    console.error('❌ Canvas not found!');
                    return false;
                }

                const ctx = canvas.getContext('2d');
                AppState.mainChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: [],
                        datasets: [{
                            label: 'Bank Nifty Live Price',
                            data: [],
                            borderColor: '#005bea',
                            backgroundColor: 'rgba(0, 91, 234, 0.1)',
                            borderWidth: 3,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#005bea',
                            spanGaps: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                                labels: {
                                    font: { size: 14 },
                                    color: '#333'
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                padding: 12,
                                titleFont: { size: 14 },
                                bodyFont: { size: 13 },
                                callbacks: {
                                    label: (ctx) => `Price: ${Utils.formatCurrency(ctx.parsed.y)}`
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: false,
                                ticks: {
                                    callback: (value) => Utils.formatCurrency(value),
                                    font: { size: 11 }
                                },
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.05)'
                                }
                            },
                            x: {
                                ticks: {
                                    maxRotation: 45,
                                    minRotation: 45,
                                    font: { size: 10 }
                                },
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.05)'
                                }
                            }
                        },
                        animation: {
                            duration: CONFIG.CHART_ANIMATION_DURATION
                        }
                    }
                });

                console.log('✅ Main chart initialized');
                return true;
            },

            updateMainChart: (timestamp, price) => {
                if (!AppState.mainChart) return;

                AppState.dataSeries.timestamps.push(timestamp);
                AppState.dataSeries.prices.push(price);

                // Keep only last N points for performance
                if (AppState.dataSeries.timestamps.length > CONFIG.MAX_DATA_POINTS) {
                    AppState.dataSeries.timestamps.shift();
                    AppState.dataSeries.prices.shift();
                }

                AppState.mainChart.data.labels = AppState.dataSeries.timestamps;
                AppState.mainChart.data.datasets[0].data = AppState.dataSeries.prices;
                AppState.mainChart.update('none'); // Use 'none' for better performance
            },

                            initDetailChart: (data) => {
            const canvas = document.getElementById('stockDetailChart');
            if (!canvas) return;

            // 🔥 FIX: get existing chart from Chart.js registry
            const existingChart = Chart.getChart(canvas);
            if (existingChart) {
                existingChart.destroy();
            }

            const ctx = canvas.getContext('2d');

            const chartData = [data.dayLow, data.lastPrice, data.dayHigh];

            AppState.detailChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Low', 'Current', 'High'],
                    datasets: [{
                        data: chartData,
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    animation: false
                }
            });
        }


        };

        // API Manager
        const API = {
            fetchBankNiftyLive: () => {
                if (AppState.isUpdating) {
                    console.log('⏭️ Update already in progress, skipping...');
                    return;
                }

                AppState.isUpdating = true;
                Utils.showLoading('#priceChangeIndicator');

                $.ajax({
                    url: '/get-stocks',
                    method: 'GET',
                    timeout: CONFIG.API_TIMEOUT,
                    success: (res) => {
                        if (!res.success || !res.data) {
                            Utils.showError('Invalid data received');
                            return;
                        }

                        UIManager.updateMainView(res.data);
                        console.log('✅ Data updated successfully');
                    },
                    error: (xhr, status, error) => {
                        console.error('❌ API Error:', { status, error });
                        Utils.showError('Connection failed');
                    },
                    complete: () => {
                        AppState.isUpdating = false;
                    }
                });
            },

            fetchStockList: () => {
                Utils.showLoading('#stockTable tbody');

                $.ajax({
                    url: '/get-bankstock-list',
                    method: 'GET',
                    timeout: CONFIG.API_TIMEOUT,
                    success: (res) => {
                        if (!res.success || !res.data || res.data.length === 0) {
                            $('#stockTable tbody').html(
                                '<tr><td colspan="8" class="text-center py-3 text-danger">' +
                                'No stock data available</td></tr>'
                            );
                            return;
                        }

                        UIManager.renderStockTable(res.data);
                        console.log('✅ Stock list loaded');
                    },
                    error: (xhr, status, err) => {
                        console.error('❌ Failed to load stock list:', err);
                        $('#stockTable tbody').html(
                            '<tr><td colspan="8" class="text-center py-3 text-danger">' +
                            '<i class="fas fa-exclamation-triangle"></i> Error loading data</td></tr>'
                        );
                    }
                });
            },

            fetchStockQuote: (symbol) => {
                $.ajax({
                    url: `/get-equity-quote?symbol=${symbol}`,
                    method: 'GET',
                    timeout: CONFIG.API_TIMEOUT,
                    success: (res) => {
                        if (!res.success) {
                            alert('Error: ' + res.message);
                            return;
                        }

                        UIManager.displayStockDetail(res.data);
                        console.log('✅ Stock quote loaded:', symbol);
                    },
                    error: (err) => {
                        console.error('❌ Failed to load quote:', err);
                        alert('Failed to load stock details');
                    }
                });
            }
        };

        // UI Manager
        const UIManager = {
            updateMainView: (data) => {
                // Update header
                $('#chartTitle').text(`${data.symbol} - ${data.indexName}`);
                $('#currentPrice').text(Utils.formatCurrency(data.lastPrice));

                // Update price change indicator
                const pct = (data.percentChange || 0).toFixed(2);
                const changeClass = data.change >= 0 ? 'text-success' : 'text-danger';
                const changeIcon = data.change >= 0 ? 'fa-arrow-up' : 'fa-arrow-down';

                $('#priceChangeIndicator').html(
                    `<i class="fas ${changeIcon} ${changeClass} me-1"></i>
                    ${Utils.formatCurrency(Math.abs(data.change || 0))}
                    <span class="${changeClass}">(${pct}%)</span>`
                );

                // Update stats cards
                $('#dayHigh').text(Utils.formatCurrency(data.dayHigh));
                $('#dayLow').text(Utils.formatCurrency(data.dayLow));
                $('#volume').text(Utils.formatVolume(data.totalTradedVolume));

                // Calculate and display moving average
                const ma = Utils.calculateMA(
                    AppState.dataSeries.prices,
                    CONFIG.MOVING_AVERAGE_PERIOD
                );
                $('#ma50').text(Utils.formatCurrency(ma));

                // Update chart
                const timeLabel = Utils.formatTime();
                ChartManager.updateMainChart(timeLabel, data.lastPrice);
            },

            renderStockTable: (stocks) => {
                let rows = '';

                stocks.forEach(stock => {
                    const changeClass = (stock.change || 0) >= 0 ? 'text-success' : 'text-danger';

                    rows += `
                        <tr>
                            <td class="fw-bold">${stock.symbol}</td>
                            <td class="${changeClass} fw-bold">
                                ${Utils.formatCurrency(stock.lastPrice || 0)}
                            </td>
                            <td>${Utils.formatCurrency(stock.open || 0)}</td>
                            <td class="text-success">${Utils.formatCurrency(stock.dayHigh || 0)}</td>
                            <td class="text-danger">${Utils.formatCurrency(stock.dayLow || 0)}</td>
                            <td>${Utils.formatCurrency(stock.previousClose || 0)}</td>
                            <td>${Utils.formatVolume(stock.totalTradedVolume || 0)}</td>
                            <td>
                                <button class="btn btn-sm btn-primary"
                                    onclick="loadStockDetail('${stock.symbol}')">
                                    <i class="fas fa-eye"></i> View
                                </button>
                            </td>
                        </tr>
                    `;
                });

                $('#stockTable tbody').html(rows);
            },

            displayStockDetail: (data) => {
                const info = data.info || {};
                const priceInfo = data.priceInfo || {};

                $('#detailCompany').text(info.companyName || 'N/A');
                $('#detailSymbol').text(info.symbol || 'N/A');

                $('#detailIndustry').text(info.industry || 'N/A');
                $('#detailLastPrice').text(Utils.formatCurrency(priceInfo.lastPrice || 0));

                const change = priceInfo.change || 0;
                const changeClass = change >= 0 ? 'price-up' : 'price-down';
                const changeIcon = change >= 0 ? '▲' : '▼';

                $('#detailChange').html(`${changeIcon} ${Math.abs(change).toFixed(2)}`);
                $('#detailChange').attr('class', `fs-5 ${changeClass}`);

                $('#detailPChange').text(`${(priceInfo.pChange || 0).toFixed(2)}%`);
                $('#detailPChange').attr('class', `small ${changeClass}`);

                $('#detailDayHigh').text(
                    Utils.formatCurrency(priceInfo.intraDayHighLow?.max || 0)
                );
                $('#detailDayLow').text(
                    Utils.formatCurrency(priceInfo.intraDayHighLow?.min || 0)
                );

                $('#detailLastUpdate').text(`Last update: ${Utils.formatTime()}`);

                // Show detail section and init chart
                $('#stockDetailSection').removeClass('d-none');
                ChartManager.initDetailChart({
                    dayLow: priceInfo.intraDayHighLow?.min || 0,
                    lastPrice: priceInfo.lastPrice || 0,
                    dayHigh: priceInfo.intraDayHighLow?.max || 0
                });

                // Smooth scroll to detail
                $('html, body').animate({
                    scrollTop: $('#stockDetailSection').offset().top - 20
                }, 500);
            }
        };

        // Global function for button onclick
        window.loadStockDetail = (symbol) => {
            API.fetchStockQuote(symbol);
        };

        // Application Initialization
        $(document).ready(() => {
            console.log('🚀 Bank Nifty Live Tracker - Initializing...');

            // Initialize main chart
            if (ChartManager.initMainChart()) {
                // Initial data fetch
                API.fetchBankNiftyLive();
                API.fetchStockList();

                // Setup auto-refresh with setInterval
                AppState.updateTimer = setInterval(() => {
                    API.fetchBankNiftyLive();
                }, CONFIG.UPDATE_INTERVAL);

                console.log(`✅ Auto-refresh enabled (${CONFIG.UPDATE_INTERVAL/1000}s interval)`);
            } else {
                Utils.showError('Chart initialization failed');
            }

            // Cleanup on page unload
            $(window).on('beforeunload', () => {
                if (AppState.updateTimer) {
                    clearInterval(AppState.updateTimer);
                }
                if (AppState.mainChart) {
                    AppState.mainChart.destroy();
                }
                if (AppState.detailChart) {
                    AppState.detailChart.destroy();
                }
            });
        });
    </script>
</body>
</html>
